{
  "description": "rtk hook — token optimization for Claude Code",
  "hooks": {
    "PreToolUse": [{
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "shell": "bash",
        "command": "rtk hook claude",
        "timeout": 5000
      }]
    }],
    "PostToolUse": [{
      "matcher": "Bash",
      "hooks": [{
        "type": "command",
        "shell": "bash",
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/collector.cjs\"",
        "timeout": 5
      }]
    }]
  }
}
